# syntax=docker/dockerfile:1
FROM python:3.11-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq5 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.darts-collector.txt .
RUN --mount=type=cache,id=clubiq-pip-cache,target=/root/.cache/pip \
    pip install --retries 12 --timeout 120 --prefer-binary -r requirements.darts-collector.txt
COPY darts_collector.py darts_feed.py darts_training.py darts_tournament.py darts_live.py darts_ranking.py darts_resilience.py darts_transport.py db_config.py ./
COPY static/darts-trainings.json static/darts-trainings.json
RUN useradd --system --uid 10001 --home /app clubiq \
    && mkdir /state && chown clubiq:clubiq /state
USER clubiq
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
    CMD python -c "from pathlib import Path;import time;p=Path('/state/status.json');assert p.is_file() and time.time()-p.stat().st_mtime<180"
ENTRYPOINT ["python", "darts_collector.py"]
CMD ["--status-file", "/state/status.json"]
